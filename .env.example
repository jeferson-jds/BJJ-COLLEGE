# Supabase Configuration
# Preencha com as credenciais do seu projeto no Supabase (Configurações > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AVISO DE SEGURANÇA:
# NUNCA insira a SUPABASE_SERVICE_ROLE_KEY aqui no frontend (.env).
# A Service Role Key deve ser mantida estritamente segura dentro do ambiente de Edge Functions do Supabase.
